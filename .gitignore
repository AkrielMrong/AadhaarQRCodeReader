# ──────────────────────────────────────────────────────────────────────────────
# .gitignore — Aadhaar QR Code Reader
# Covers: macOS, Windows, Linux, VS Code, JetBrains, Node.js, web tooling
#
# @author  Prashantt Tripathi <https://github.com/ptprashanttripathi>
# ──────────────────────────────────────────────────────────────────────────────


# ── Operating system ──────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/


# ── Editors & IDEs ────────────────────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
# Keep .vscode/extensions.json if you share recommended extensions
!.vscode/extensions.json

.idea/
*.iml
*.iws
*.ipr

*.swp
*.swo
*.bak
*~


# ── Node.js / npm / yarn ──────────────────────────────────────────────────────
node_modules/
.npm/
.pnp/
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.yarn/cache
.yarn/unplugged
.yarn/install-state.gz
.pnp.*


# ── Build & bundler outputs ───────────────────────────────────────────────────
dist/
build/
out/
.cache/
.parcel-cache/
.turbo/
*.min.js.map
*.min.css.map


# ── Environment & secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example
.env.local
.env.development
.env.staging
.env.production


# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log


# ── Test & coverage ───────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov


# ── Temporary files ───────────────────────────────────────────────────────────
tmp/
temp/
*.tmp
*.temp

# ── Python & virtual environments ─────────────────────────────────────────────
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

